{
    "RESET": {
        "summary": "Clears entries from the specified type of command log. Clears both the recency and magnitude entries unless one is selected.",
        "complexity": "O(N) where N is the number of entries in the commandlog",
        "group": "server",
        "since": "8.1.0",
        "arity": -3,
        "container": "COMMANDLOG",
        "function": "commandlogCommand",
        "history": [
            [
                "9.2.0",
                "Added the `RECENCY` and `MAGNITUDE` options."
            ]
        ],
        "command_flags": [
            "ADMIN",
            "LOADING",
            "STALE"
        ],
        "command_tips": [
            "REQUEST_POLICY:ALL_NODES",
            "RESPONSE_POLICY:ALL_SUCCEEDED"
        ],
        "reply_schema": {
            "const": "OK"
        },
        "arguments": [
            {
                "name": "type",
                "type": "oneof",
                "arguments": [
                    {
                        "name": "slow",
                        "type": "pure-token",
                        "token": "slow"
                    },
                    {
                        "name": "large-request",
                        "type": "pure-token",
                        "token": "large-request"
                    },
                    {
                        "name": "large-reply",
                        "type": "pure-token",
                        "token": "large-reply"
                    }
                ]
            },
            {
                "name": "store",
                "type": "oneof",
                "optional": true,
                "since": "9.2.0",
                "arguments": [
                    {
                        "name": "recency",
                        "type": "pure-token",
                        "token": "RECENCY"
                    },
                    {
                        "name": "magnitude",
                        "type": "pure-token",
                        "token": "MAGNITUDE"
                    }
                ]
            }
        ],
        "acl_categories": [
            "ADMIN",
            "DANGEROUS",
            "SLOW"
        ]
    }
}
