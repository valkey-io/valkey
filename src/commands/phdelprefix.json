{
    "PHDELPREFIX": {
        "summary": "Deletes every stored path in a path hash below a prefix.",
        "complexity": "O(L + sum(P_i + F_i)), where L is the prefix length, P_i is the length of each matched path, and F_i is the number of fields in its payload.",
        "group": "pathhash",
        "since": "9.2.0",
        "arity": 3,
        "function": "phdelprefixCommand",
        "command_flags": ["WRITE"],
        "acl_categories": ["PATHHASH", "WRITE", "SLOW"],
        "key_specs": [{"flags": ["RW", "ACCESS", "DELETE"], "begin_search": {"index": {"pos": 1}}, "find_keys": {"range": {"lastkey": 0, "step": 1, "limit": 0}}}],
        "reply_schema": {"type": "integer"},
        "arguments": [
            {"name": "key", "type": "key", "key_spec_index": 0},
            {"name": "prefix", "type": "string"}
        ]
    }
}
