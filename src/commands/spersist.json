{
    "SPERSIST": {
        "summary": "Removes expiration times from set members.",
        "complexity": "O(N) where N is the number of specified members.",
        "group": "set",
        "since": "10.0.0",
        "arity": -5,
        "function": "spersistCommand",
        "command_flags": [
            "WRITE",
            "FAST"
        ],
        "acl_categories": [
            "FAST",
            "SET",
            "WRITE"
        ],
        "key_specs": [
            {
                "flags": [
                    "RW",
                    "UPDATE"
                ],
                "begin_search": {
                    "index": {
                        "pos": 1
                    }
                },
                "find_keys": {
                    "range": {
                        "lastkey": 0,
                        "step": 1,
                        "limit": 0
                    }
                }
            }
        ],
        "reply_schema": {
            "description": "List of integer codes indicating the result of removing the expiration from each member, in the order specified.",
            "type": "array",
            "minItems": 1,
            "items": {
                "oneOf": [
                    {
                        "description": "The member does not exist in the set, or the key does not exist.",
                        "const": -2
                    },
                    {
                        "description": "The member exists in the set but has no expiration.",
                        "const": -1
                    },
                    {
                        "description": "The expiration was removed from the member.",
                        "const": 1
                    }
                ]
            }
        },
        "arguments": [
            {
                "name": "key",
                "type": "key",
                "key_spec_index": 0
            },
            {
                "name": "members",
                "token": "MEMBERS",
                "type": "block",
                "arguments": [
                    {
                        "name": "nummembers",
                        "type": "integer",
                        "multiple": false,
                        "minimum": 1
                    },
                    {
                        "name": "member",
                        "type": "member",
                        "multiple": true
                    }
                ]
            }
        ]
    }
}
