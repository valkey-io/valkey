# FlashCache Benchmark Config: Steady-state 512B (matches Valkey T14 params)
# 8GB flash, 4M items, 512B constant values, 4:1 read:write ratio

DB_FILE=/mnt/nvme/fc.db
DB_SIZE_GIB=8
MAX_ITEMS=4000000
VALUE_SIZES="512"
VALUE_DIST=constant_dist
NUM_LARGE_ITEMS=0
READ_PREF=prefer_old_item
TPS_LIMIT=0
STAT_INTERVAL=2000000
READ_WRITE_RATIO=4
SNAPSHOT_VER=2
SNAPSHOT_TYPE=bgsave
