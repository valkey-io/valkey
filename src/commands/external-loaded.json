        "arity": 3,
        "container": "EXTERNAL_DATA",
        "function": "externalDataLoadedCommand",
        "command_flags": [
            "FAST",
            "READONLY"
        ],
        "acl_categories": [
            "FAST",
            "KEYSPACE",
            "READ"
        ],
        "command_tips": [
            "NONDETERMINISTIC_OUTPUT_ORDER"
        ],
        "arguments": [
            {
                "name": "type",
