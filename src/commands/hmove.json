{
    "HMOVE": {
        "summary": "Moves one or more fields from one hash to another and overwrites existing destination fields.",
        "complexity": "O(N) where N is the number of field move pairs.",
        "group": "hash",
        "since": "9.2.0",
        "arity": -5,
        "function": "hmoveCommand",
        "command_flags": [
            "WRITE",
            "FAST"
        ],
        "acl_categories": [
            "FAST",
            "HASH",
            "WRITE"
        ],
        "key_specs": [
            {
                "flags": [
                    "RW",
                    "ACCESS",
                    "DELETE"
                ],
                "begin_search": {
                    "index": {
                        "pos": 1
                    }
                },
                "find_keys": {
                    "range": {
                        "lastkey": 0,
                        "step": 1,
                        "limit": 0
                    }
                }
            },
            {
                "flags": [
                    "RW",
                    "UPDATE"
                ],
                "begin_search": {
                    "index": {
                        "pos": 2
                    }
                },
                "find_keys": {
                    "range": {
                        "lastkey": 0,
                        "step": 1,
                        "limit": 0
                    }
                }
            }
        ],
        "reply_schema": {
            "description": "List of integer codes indicating the result of each field move pair, in the same order as requested.",
            "type": "array",
            "minItems": 1,
            "items": {
                "oneOf": [
                    {
                        "description": "The source field does not exist.",
                        "const": 0
                    },
                    {
                        "description": "The source field was moved.",
                        "const": 1
                    }
                ]
            }
        },
        "arguments": [
            {
                "name": "source",
                "type": "key",
                "key_spec_index": 0
            },
            {
                "name": "destination",
                "type": "key",
                "key_spec_index": 1
            },
            {
                "name": "data",
                "type": "block",
                "multiple": true,
                "arguments": [
                    {
                        "name": "old-field",
                        "type": "string"
                    },
                    {
                        "name": "new-field",
                        "type": "string"
                    }
                ]
            }
        ]
    }
}
