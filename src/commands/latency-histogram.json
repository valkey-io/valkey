{
    "HISTOGRAM": {
        "summary": "Returns the cumulative distribution of latencies of a subset or all commands. With CMD (default) returns processing-time histograms; with E2E returns the per-command end-to-end latency histograms.",
        "complexity": "O(N) where N is the number of commands with latency information being retrieved.",
        "group": "server",
        "since": "7.0.0",
        "arity": -2,
        "container": "LATENCY",
        "function": "latencyCommand",
        "command_flags": [
            "ADMIN",
            "NOSCRIPT",
            "LOADING",
            "STALE"
        ],
        "command_tips": [
            "NONDETERMINISTIC_OUTPUT",
            "REQUEST_POLICY:ALL_NODES",
            "RESPONSE_POLICY:SPECIAL"
        ],
        "reply_schema": {
            "type": "object",
            "description": "A map where each key is a command name, and each value is a map with the total calls, and an inner map of the histogram time buckets.",
            "patternProperties": {
                "^.*$": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "calls": {
                            "description": "The total calls for the command.",
                            "type": "integer",
                            "minimum": 0
                        },
                        "histogram_usec": {
                            "description": "Histogram map, bucket id to latency",
                            "type": "object",
                            "additionalProperties": {
                                "type": "integer"
                            }
                        }
                    }
                }
            }
        },
        "arguments": [
            {
                "name": "metric",
                "type": "oneof",
                "optional": true,
                "since": "9.2.0",
                "arguments": [
                    {
                        "name": "cmd",
                        "type": "pure-token",
                        "token": "CMD"
                    },
                    {
                        "name": "e2e",
                        "type": "pure-token",
                        "token": "E2E"
                    }
                ]
            },
            {
                "name": "COMMAND",
                "type": "string",
                "optional": true,
                "multiple": true
            }
        ],
        "acl_categories": [
            "ADMIN",
            "DANGEROUS",
            "SLOW"
        ]
    }
}
