{
    "E2E_HISTOGRAM": {
        "summary": "Returns the cumulative distribution of end-to-end latencies of every command kind.",
        "complexity": "O(1)",
        "group": "server",
        "since": "10.0.0",
        "arity": 2,
        "container": "LATENCY",
        "function": "latencyCommand",
        "command_flags": [
            "ADMIN",
            "NOSCRIPT",
            "LOADING",
            "STALE"
        ],
        "command_tips": [
            "NONDETERMINISTIC_OUTPUT",
            "REQUEST_POLICY:ALL_NODES",
            "RESPONSE_POLICY:SPECIAL"
        ],
        "reply_schema": {
            "type": "object",
            "description": "A map where each key is a command kind (write, read, auth, other), and each value is a map with the total samples, and an inner map of the histogram time buckets.",
            "patternProperties": {
                "^(write|read|auth|other)$": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "calls": {
                            "description": "The total samples for the command kind.",
                            "type": "integer",
                            "minimum": 0
                        },
                        "histogram_usec": {
                            "description": "Histogram map, bucket id to latency",
                            "type": "object",
                            "additionalProperties": {
                                "type": "integer"
                            }
                        }
                    }
                }
            },
            "additionalProperties": false
        },
        "acl_categories": [
            "ADMIN",
            "DANGEROUS",
            "SLOW"
        ]
    }
}
