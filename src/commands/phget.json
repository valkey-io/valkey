{
    "PHGET": {
        "summary": "Returns one or more fields from an exact path in a path hash.",
        "complexity": "O(L + F*U).",
        "group": "pathhash",
        "since": "9.2.0",
        "arity": -4,
        "function": "phgetCommand",
        "command_flags": ["READONLY", "FAST"],
        "acl_categories": ["PATHHASH", "READ", "FAST"],
        "key_specs": [{"flags": ["RO", "ACCESS"], "begin_search": {"index": {"pos": 1}}, "find_keys": {"range": {"lastkey": 0, "step": 1, "limit": 0}}}],
        "reply_schema": {
            "description": "Values in the requested field order, with null for each missing field. Always an array, including for a single field.",
            "type": "array",
            "items": {"oneOf": [{"type": "string"}, {"type": "null"}]}
        },
        "arguments": [
            {"name": "key", "type": "key", "key_spec_index": 0},
            {"name": "path", "type": "string"},
            {"name": "field", "type": "string", "multiple": true}
        ]
    }
}
