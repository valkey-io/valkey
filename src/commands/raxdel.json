        "complexity": "O(L + F*U).",
        "group": "radix",
        "since": "9.2.0",
        "arity": -3,
        "function": "raxdelCommand",
        "command_flags": ["WRITE", "FAST"],
        "acl_categories": ["RADIX", "WRITE", "FAST"],
        "key_specs": [{"flags": ["RW", "ACCESS", "DELETE"], "begin_search": {"index": {"pos": 1}}, "find_keys": {"range": {"lastkey": 0, "step": 1, "limit": 0}}}],
        "reply_schema": {"type": "integer"},
        "arguments": [
            {"name": "key", "type": "key", "key_spec_index": 0},
            {"name": "path", "type": "string"},
            {"name": "field", "type": "string", "optional": true, "multiple": true}
        ]
    }
}
