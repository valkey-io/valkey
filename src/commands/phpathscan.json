{
    "PHPATHSCAN": {
        "summary": "Incrementally traverses paths in a path hash in lexicographic order.",
        "complexity": "O(L + C + O) per call.",
        "group": "pathhash",
        "since": "9.2.0",
        "arity": -3,
        "function": "phpathscanCommand",
        "command_flags": ["READONLY"],
        "acl_categories": ["PATHHASH", "READ", "SLOW"],
        "key_specs": [{"flags": ["RO", "ACCESS"], "begin_search": {"index": {"pos": 1}}, "find_keys": {"range": {"lastkey": 0, "step": 1, "limit": 0}}}],
        "reply_schema": {
            "description": "Opaque cursor and stored path names in byte lexicographic order.",
            "type": "array", "minItems": 2, "maxItems": 2,
            "items": [
                {"description": "The next opaque path cursor, or 0 when complete.", "type": "string"},
                {"description": "Stored path names.", "type": "array", "items": {"type": "string"}}
            ]
        },
        "arguments": [
            {"name": "key", "type": "key", "key_spec_index": 0},
            {"name": "cursor", "type": "string"},
            {"name": "prefix", "type": "string", "token": "PREFIX", "optional": true},
            {"name": "count", "summary": "Maximum number of paths to return; defaults to 10.", "type": "integer", "token": "COUNT", "optional": true}
        ]
    }
}
