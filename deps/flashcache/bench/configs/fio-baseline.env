# FlashCache Benchmark Config: fio baseline only
# Run with: ./fc-bench.sh configs/fio-baseline.env --host HOST --fio --tag fio-baseline
# This config is used only for the fio step; FC params below are placeholders.

DB_FILE=/mnt/nvme/fc.db
DB_SIZE_GIB=8
MAX_ITEMS=4000000
VALUE_SIZES="512"
VALUE_DIST=constant_dist
NUM_LARGE_ITEMS=0
READ_PREF=prefer_old_item
TPS_LIMIT=0
STAT_INTERVAL=2000000
READ_WRITE_RATIO=4
SNAPSHOT_VER=2
SNAPSHOT_TYPE=bgsave
