{
    "GET": {
        "summary": "Returns the specified command log's entries.",
        "complexity": "O(N) where N is the number of entries returned",
        "group": "server",
        "since": "8.1.0",
        "arity": 4,
        "container": "COMMANDLOG",
        "function": "commandlogCommand",
        "history": [
            [
                "9.2.0",
                "Added the user name to the reply."
            ]
        ],
        "command_flags": [
            "ADMIN",
            "LOADING",
            "STALE"
        ],
        "command_tips": [
            "REQUEST_POLICY:ALL_NODES",
            "NONDETERMINISTIC_OUTPUT"
        ],
        "reply_schema": {
            "type": "array",
            "description": "Entries from the command log in chronological order.",
            "uniqueItems": true,
            "items": {
                "type": "array",
                "minItems": 7,
                "maxItems": 7,
                "items": [
                    {
                        "type": "integer",
                        "description": "Command log entry ID."
                    },
                    {
                        "type": "integer",
                        "description": "The unix timestamp at which the logged command was processed.",
                        "minimum": 0
                    },
                    {
                        "type": "integer",
                        "description": "Determined by the type parameter.",
                        "minimum": 0
                    },
                    {
                        "type": "array",
                        "description": "The arguments of the command.",
                        "items": {
                            "type": "string"
                        }
                    },
                    {
                        "type": "string",
                        "description": "Client IP address and port."
                    },
                    {
                        "type": "string",
                        "description": "Client name if set via the CLIENT SETNAME command."
                    },
                    {
                        "type": "string",
                        "description": "The name of the ACL user the client was authenticated as."
                    }
                ]
            }
        },
        "arguments": [
            {
                "name": "count",
                "type": "integer"
            },
            {
                "name": "type",
                "type": "oneof",
                "arguments": [
                    {
                        "name": "slow",
                        "type": "pure-token",
                        "token": "slow"
                    },
                    {
                        "name": "large-request",
                        "type": "pure-token",
                        "token": "large-request"
                    },
                    {
                        "name": "large-reply",
                        "type": "pure-token",
                        "token": "large-reply"
                    }
                ]
            }
        ],
        "acl_categories": [
            "ADMIN",
            "DANGEROUS",
            "SLOW"
        ]
    }
}
