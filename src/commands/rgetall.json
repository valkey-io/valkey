{
    "RGETALL": {
        "summary": "Returns all fields and values at an exact radix tree path.",
        "complexity": "O(L + N), where N is the payload size.",
        "group": "radix",
        "since": "9.0.0",
        "arity": 3,
        "function": "rgetallCommand",
        "command_flags": ["READONLY"],
        "acl_categories": ["RADIX", "READ", "SLOW"],
        "command_tips": ["NONDETERMINISTIC_OUTPUT_ORDER"],
        "key_specs": [{
            "flags": ["RO", "ACCESS"],
            "begin_search": {"index": {"pos": 1}},
            "find_keys": {"range": {"lastkey": 0, "step": 1, "limit": 0}}
        }],
        "arguments": [
            {"name": "key", "type": "key", "key_spec_index": 0},
            {"name": "path", "type": "string"}
        ]
    }
}
