# FlashCache Benchmark Config: FC-T3 Size Sweep — 512b values
# prefer_new_item, 4:1 R/W (matches original T3 conditions)

DB_FILE=/mnt/nvme/fc.db
DB_SIZE_GIB=8
MAX_ITEMS=4000000
VALUE_SIZES="512"
VALUE_DIST=constant_dist
NUM_LARGE_ITEMS=0
READ_PREF=prefer_new_item
TPS_LIMIT=0
STAT_INTERVAL=2000000
READ_WRITE_RATIO=4
SNAPSHOT_VER=2
SNAPSHOT_TYPE=bgsave
