{
    "R.EXPORT": {
        "summary": "Returns the set bits of a bitmap or a string as a Roaring bitmap in the portable serialization format.",
        "complexity": "O(N) where N is the size of the serialized bitmap, or the length of the string for a string.",
        "group": "bitmap",
        "since": "9.3.0",
        "arity": 2,
        "function": "rexportCommand",
        "command_flags": [
            "READONLY"
        ],
        "acl_categories": [
            "BITMAP",
            "READ",
            "SLOW"
        ],
        "key_specs": [
            {
                "flags": [
                    "RO",
                    "ACCESS"
                ],
                "begin_search": {
                    "index": {
                        "pos": 1
                    }
                },
                "find_keys": {
                    "range": {
                        "lastkey": 0,
                        "step": 1,
                        "limit": 0
                    }
                }
            }
        ],
        "reply_schema": {
            "oneOf": [
                {
                    "description": "The set bits, as a Roaring bitmap in the portable serialization format.",
                    "type": "string"
                },
                {
                    "description": "Key does not exist.",
                    "type": "null"
                }
            ]
        },
        "arguments": [
            {
                "name": "key",
                "type": "key",
                "key_spec_index": 0
            }
        ]
    }
}
