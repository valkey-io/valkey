{
    "RAXSET": {
        "summary": "Atomically sets one or more fields at a radix-tree path.",
        "complexity": "O(L + F*U), where L is the path length, F is the number of fields, and U is the payload field lookup cost.",
        "group": "radix",
        "since": "9.2.0",
        "arity": -7,
        "function": "raxsetCommand",
        "command_flags": ["WRITE", "DENYOOM", "FAST"],
        "acl_categories": ["RADIX", "WRITE", "FAST"],
        "key_specs": [{
            "flags": ["RW", "UPDATE"],
            "begin_search": {"index": {"pos": 1}},
            "find_keys": {"range": {"lastkey": 0, "step": 1, "limit": 0}}
        }],
        "reply_schema": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "arguments": [
            {"name": "key", "type": "key", "key_spec_index": 0},
            {"name": "path", "type": "string"},
            {"name": "condition", "type": "oneof", "optional": true, "arguments": [
                {"name": "fnx", "type": "pure-token", "token": "FNX"},
                {"name": "fxx", "type": "pure-token", "token": "FXX"}
            ]},
            {"name": "fields", "type": "block", "token": "FIELDS", "arguments": [
                {"name": "numfields", "type": "integer", "minimum": 1},
                {"name": "data", "type": "block", "multiple": true, "arguments": [
                    {"name": "field", "type": "string"},
                    {"name": "value", "type": "string"}
                ]}
            ]}
        ]
    }
}
