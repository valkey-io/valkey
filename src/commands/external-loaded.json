                "arguments": [
                    {
                        "name": "storage",
                        "type": "pure-token",
                        "token": "STORAGE"
                    },
                    {
                        "name": "filter",
                        "type": "pure-token",
                        "token": "FILTER"
                    }
                ]
            }
        ],
        "reply_schema": {
            "anyOf": [
                {
                    "type": "array",
                    "description": "In case `storage` was given, a list of loaded storages",
                    "items": {
