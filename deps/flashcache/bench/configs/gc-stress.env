# FlashCache Benchmark Config: GC Stress
# 8GB flash, 2M items (fills faster -> more overwrites -> GC pressure)
# 1:1 read:write, prefer_new_item (reads recently written = less likely to be GC'd)

DB_FILE=/mnt/nvme/fc.db
DB_SIZE_GIB=8
MAX_ITEMS=2000000
VALUE_SIZES="512"
VALUE_DIST=constant_dist
NUM_LARGE_ITEMS=0
READ_PREF=prefer_new_item
TPS_LIMIT=0
STAT_INTERVAL=2000000
READ_WRITE_RATIO=1
SNAPSHOT_VER=2
SNAPSHOT_TYPE=bgsave
