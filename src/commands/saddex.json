{
    "SADDEX": {
        "summary": "Adds one or more members to a set and optionally sets their expiration time.",
        "complexity": "O(N) where N is the number of specified members.",
        "group": "set",
        "since": "10.0.0",
        "arity": -5,
        "function": "saddexCommand",
        "command_flags": [
            "WRITE",
            "DENYOOM",
            "FAST"
        ],
        "acl_categories": [
            "FAST",
            "SET",
            "WRITE"
        ],
        "key_specs": [
            {
                "flags": [
                    "RW",
                    "INSERT"
                ],
                "begin_search": {
                    "index": {
                        "pos": 1
                    }
                },
                "find_keys": {
                    "range": {
                        "lastkey": 0,
                        "step": 1,
                        "limit": 0
                    }
                }
            }
        ],
        "reply_schema": {
            "oneOf": [
                {
                    "description": "None of the provided members or their expiration time was set.",
                    "const": 0
                },
                {
                    "description": "All the provided members and their expiration time were set.",
                    "const": 1
                }
            ]
        },
        "arguments": [
            {
                "name": "key",
                "type": "key",
                "key_spec_index": 0
            },
            {
                "name": "key-condition",
                "type": "oneof",
                "optional": true,
                "arguments": [
                    {
                        "name": "nx",
                        "type": "pure-token",
                        "token": "NX"
                    },
                    {
                        "name": "xx",
                        "type": "pure-token",
                        "token": "XX"
                    }
                ]
            },
            {
                "name": "members-condition",
                "type": "oneof",
                "optional": true,
                "arguments": [
                    {
                        "name": "mnx",
                        "type": "pure-token",
                        "token": "MNX"
                    },
                    {
                        "name": "mxx",
                        "type": "pure-token",
                        "token": "MXX"
                    }
                ]
            },
            {
                "name": "expiration",
                "type": "oneof",
                "optional": true,
                "arguments": [
                    {
                        "name": "seconds",
                        "type": "integer",
                        "token": "EX"
                    },
                    {
                        "name": "milliseconds",
                        "type": "integer",
                        "token": "PX"
                    },
                    {
                        "name": "unix-time-seconds",
                        "type": "unix-time",
                        "token": "EXAT"
                    },
                    {
                        "name": "unix-time-milliseconds",
                        "type": "unix-time",
                        "token": "PXAT"
                    },
                    {
                        "name": "keepttl",
                        "type": "pure-token",
                        "token": "KEEPTTL"
                    }
                ]
            },
            {
                "name": "members",
                "token": "MEMBERS",
                "type": "block",
                "arguments": [
                    {
                        "name": "nummembers",
                        "type": "integer",
                        "multiple": false,
                        "minimum": 1
                    },
                    {
                        "name": "member",
                        "type": "member",
                        "multiple": true
                    }
                ]
            }
        ]
    }
}
