# FlashCache Benchmark Config: Size Sweep (mixed value sizes)
# Tests FC performance across value sizes: 500B (common), 4KB (medium), 64KB (large), 512KB (xlarge)
# Equal weight = 25% of writes at each size

DB_FILE=/mnt/nvme/fc.db
DB_SIZE_GIB=8
MAX_ITEMS=1000000
VALUE_SIZES="500:1,4096:1,65536:1,524288:1"
VALUE_DIST=constant_dist
NUM_LARGE_ITEMS=0
READ_PREF=prefer_old_item
TPS_LIMIT=0
STAT_INTERVAL=500000
READ_WRITE_RATIO=4
SNAPSHOT_VER=2
SNAPSHOT_TYPE=bgsave
